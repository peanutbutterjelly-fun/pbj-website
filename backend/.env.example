# Copy this file to .env and fill in real values. Never commit .env.
APP_NAME="PB&J API"
ENVIRONMENT=development
# Where the website runs, so the browser is allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]

# Supabase: Project Settings > API Keys, and the Connect button for the database
SUPABASE_URL=https://xpzrsslqfnhzqcxxkkjo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Secret: admin access, backend only
SUPABASE_SECRET_KEY=
# Secret: database password
SUPABASE_DB_PASSWORD=
# Secret. Locally: the direct connection. On Railway: use DATABASE_POOLER_URL's value instead
DATABASE_URL=postgresql://postgres:<password>@db.xpzrsslqfnhzqcxxkkjo.supabase.co:5432/postgres
# IPv4 session pooler (Railway has no IPv6 to the direct address)
DATABASE_POOLER_URL=postgresql://postgres.xpzrsslqfnhzqcxxkkjo:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
