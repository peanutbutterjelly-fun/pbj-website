# Copy this file to .env.local and fill in the values. .env.local stays on your computer and is never uploaded.
# Supabase: Project Settings > API Keys. Both are public (safe in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The backend (Railway)
VITE_API_URL=https://api-production-bb76bfb9.up.railway.app

# The search assistant's "step out of the zone" (optional). The web address of a small service that takes
# { query, city } and returns { answer, items: [{ title, note, url }] }. Leave empty until that service exists:
# the assistant then says it is not connected and sends nothing.
VITE_ASSISTANT_URL=
